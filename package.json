{
  "name": "zhuyin-ime",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --dir packages",
    "lint": "eslint packages",
    "format": "prettier --write \"packages/**/src/**/*.ts\" \"packages/**/test/**/*.ts\"",
    "data:lexicon": "npm run data:lexicon -w @zhuyin/data-pipeline",
    "data:corpus": "npm run data:corpus -w @zhuyin/data-pipeline",
    "data:all": "npm run data:lexicon && npm run data:corpus"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
